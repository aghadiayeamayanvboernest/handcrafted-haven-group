# --- Auth.js (NextAuth v5) ---
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Random 32-byte secret used to encrypt the session JWT.
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app — https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI:   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# On Vercel, add these same vars in Project Settings → Environment Variables,
# and add the production callback URLs (https://<your-domain>/api/auth/callback/...).

# --- Supabase (database + product image storage) ---
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used only by the db:setup / db:seed scripts.
# Supabase → Connect → Session pooler (IPv4). Not needed at runtime.
SUPABASE_DB_URL=

# One-time setup after filling the above:
#   npm run db:setup   # creates the tables
#   npm run db:seed    # loads the demo sellers + products
