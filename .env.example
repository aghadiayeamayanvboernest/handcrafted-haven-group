# --- Auth.js (NextAuth v5) ---
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Auth uses username/password (Credentials) — accounts live in the Supabase
# `users` table. Only a session secret is required here.
# Random 32-byte secret used to encrypt the session JWT.
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# On Vercel, add AUTH_SECRET (and the Supabase vars below) in
# Project Settings → Environment Variables.

# --- Supabase (database + product image storage) ---
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used only by the db:setup / db:seed scripts.
# Supabase → Connect → Session pooler (IPv4). Not needed at runtime.
SUPABASE_DB_URL=

# One-time setup after filling the above:
#   npm run db:setup   # creates the tables
#   npm run db:seed    # loads the demo sellers + products
