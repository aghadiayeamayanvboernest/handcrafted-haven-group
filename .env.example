# --- Auth.js (NextAuth v5) ---
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Random 32-byte secret used to encrypt the session JWT.
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app — https://github.com/settings/developers
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI:   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# On Vercel, add these same vars in Project Settings → Environment Variables,
# and add the production callback URLs (https://<your-domain>/api/auth/callback/...).
